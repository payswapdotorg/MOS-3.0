{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "paths": {
      "@mos/contracts": ["../mos-contracts/src/index.ts"],
      "@mos/adapters": ["../zcode-mos-adapters/src/index.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"]
}
